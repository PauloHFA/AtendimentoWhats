# Local-only development value. Use a unique secret outside local development.
POSTGRES_PASSWORD=local-development-only

# Configure these only when connecting the Meta Cloud API.
META_APP_SECRET=
META_VERIFY_TOKEN=
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_GRAPH_API_VERSION=
# Optional: enable simulated responses in the worker. Never sends to WhatsApp.
SIMULATOR_BUSINESS_NAME=
WEBHOOK_MAX_BODY_BYTES=1000000
WEBHOOK_RATE_LIMIT_REQUESTS_PER_MINUTE=120
